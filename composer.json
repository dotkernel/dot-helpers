{
    "name": "dotkernel/dot-helpers",
    "type": "library",
    "description": "Dotkernel helper component that generates and compares route URIs, for any PSR-11 container",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-helpers",
    "keywords": [
        "helper",
        "mezzio",
        "laminas"
    ],
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "laminas/laminas-diactoros": "^3.10.0",
        "mezzio/mezzio-helpers": "^5.21.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.5.22"
    },
    "autoload": {
        "psr-4": {
            "Dot\\Helpers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\Helpers\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "phpstan analyse --memory-limit 1G",
        "test": "phpunit --colors=always"
    }
}
